# Example env for local MongoDB (not used by current Postgres-based code)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example
MONGO_DB_NAME=mikeai
MONGO_URI=mongodb://root:example@localhost:27017/mikeai?authSource=admin

# NOTE: This project currently uses Neon/Postgres and expects `DATABASE_URL`.
# If you want to run the existing app locally with Docker Postgres, set:
# DATABASE_URL=postgresql://postgres:example@localhost:5432/mikeai
